# Copy to backend/.env and fill in real values. Never commit backend/.env.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=expensezen
# Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<paste-a-long-random-secret-here>
# Exact frontend origin(s), comma-separated, no wildcard when credentials are used
CORS_ORIGINS=http://localhost:3000
